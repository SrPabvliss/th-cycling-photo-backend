# Operations configuration for scripts/refresh-dev-from-prod.sh.
# Copy to .env.ops and fill in. .env.ops is not tracked — nothing about the
# server belongs in the repository.

# The backup account and the read-only database role. Ask whoever administers
# the server. The SSH key for PROD_SSH_HOST can only forward the database port
# — it gets no shell and reaches nothing else on the machine.
PROD_SSH_HOST=
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

# Optional. The port the database listens on inside the server, and the local
# port the tunnel binds. Change the local one if 15433 is taken.
PROD_REMOTE_PORT=15432
LOCAL_TUNNEL_PORT=15433

# The protected account the TIT-38 migration demands before it will run
# against a database that already has users. Required even when restoring a
# dump somebody handed you, because the migration runs either way.
BREAK_GLASS_EMAIL=

# Optional. Password every account gets locally. Defaults to test123.
DEV_PASSWORD=

# Optional. Where dumps are written. Defaults to ../cycling-photo-backups.
BACKUP_DIR=
