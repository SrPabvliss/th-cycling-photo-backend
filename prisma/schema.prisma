  user_id        String   @db.Uuid
  type           String   @db.VarChar(40)
  policy_version String   @db.VarChar(20)
  accepted_at    DateTime @default(now()) @db.Timestamptz
  ip             String?  @db.VarChar(45)
  user_agent     String?  @db.VarChar(500)
