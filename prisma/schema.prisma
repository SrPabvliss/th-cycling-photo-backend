// ─── Cart ───────────────────────────────────────────────────────────────────

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  user_id      String?    @db.Uuid
  session_id   String?    @db.VarChar(64)
  status       CartStatus @default(active)
  created_at   DateTime   @default(now()) @db.Timestamptz
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz
  expires_at   DateTime   @db.Timestamptz
  converted_at DateTime?  @db.Timestamptz

  user  User?      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([user_id])
  @@index([session_id])
  @@index([status])
  // Unique partial indexes created via raw SQL:
  // (user_id) WHERE status = 'active'
  // (session_id) WHERE status = 'active'
  @@map("carts")
}

model CartItem {
  id         String    @id @default(uuid()) @db.Uuid
  cart_id    String    @db.Uuid
  photo_id   String    @db.Uuid
  event_id   String    @db.Uuid
  added_at   DateTime  @default(now()) @db.Timestamptz
  removed_at DateTime? @db.Timestamptz

  cart  Cart  @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, photo_id])
  @@index([cart_id])
  @@index([photo_id])
  @@index([event_id])
  @@map("cart_items")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  message    String    @db.VarChar(500)
  data       Json      @default("{}")
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at(sort: Desc)])
  @@map("notifications")
}

// ─── Authorization ──────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  is_platform Boolean  @default(false)
  event_quota Int      @default(0)
  default_event_photo_quota Int?
  created_at  DateTime @default(now()) @db.Timestamptz

  public_name           String?   @db.VarChar(200)
  watermark_storage_key String?   @db.VarChar(500)
  whatsapp_number       String?   @db.VarChar(20)
  whatsapp_verified_at  DateTime? @db.Timestamptz

  users          User[]
  events         Event[]
  payout_methods TenantPayoutMethod[]

  @@map("tenants")
}

model Permission {
  id                 String  @id @default(uuid()) @db.Uuid
  key                String  @unique @db.VarChar(100)
  category           String  @db.VarChar(50)
  is_platform_only   Boolean @default(false)
  allows_event_scope Boolean @default(false)

  template_memberships PermissionTemplatePermission[]
  grants               UserPermissionGrant[]

  @@map("permissions")
}

model PermissionTemplate {
  id               String  @id @default(uuid()) @db.Uuid
  key              String  @unique @db.VarChar(50)
  name             String  @db.VarChar(100)
  is_platform_only Boolean @default(false)

  permissions PermissionTemplatePermission[]
  users       User[]

  @@map("permission_templates")
}

model PermissionTemplatePermission {
  template_id   String @db.Uuid
  permission_id String @db.Uuid

  template   PermissionTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@id([template_id, permission_id])
  @@map("permission_template_permissions")
}

enum GrantScopeType {
  global
  event

  @@map("grant_scope_type")
}

enum GrantEffect {
  allow
  deny

  @@map("grant_effect")
}

model UserPermissionGrant {
  id            String         @id @default(uuid()) @db.Uuid
  user_id       String         @db.Uuid
  permission_id String         @db.Uuid
  scope_type    GrantScopeType
  event_id      String?        @db.Uuid
  effect        GrantEffect
  granted_by_id String         @db.Uuid
  granted_at    DateTime       @default(now()) @db.Timestamptz

  user       User       @relation("GrantHolder", fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)
  event      Event?     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  granted_by User       @relation("GrantIssuer", fields: [granted_by_id], references: [id], onDelete: Restrict)

  // Declared for Prisma Client's compound `WhereUniqueInput` only, so
  // GrantPermissionHandler can `upsert` idempotently. THE PHYSICAL INDEX
  // IS NOT WHAT THIS LINE WOULD CREATE: it already exists, built by the
  // 20260818143434_tit38_grants migration's raw SQL, WITH `NULLS NOT
  // DISTINCT` — the clause that makes two global grants (event_id IS
  // NULL) collide as duplicates instead of Postgres's default of treating
  // every NULL as distinct. Prisma's schema DSL cannot express `NULLS NOT
  // DISTINCT` in an `@@unique`, so this declaration is deliberately
  // incomplete: it exists for the generated TypeScript types only.
  //
  // THE MIGRATION FILE IS THE SOURCE OF TRUTH for what's actually on the
  // database — this line is not. Never run `prisma migrate dev` or
  // `prisma db push` from this schema: Prisma will see this `@@unique` as
  // plain (NULLS-DISTINCT) drift from the real index and offer to "fix"
  // it by recreating `user_permission_grants_unique` WITHOUT `NULLS NOT
  // DISTINCT` — which reopens the duplicate-global-grant hole Task 4
  // closed and proved shut against a live database (see
  // count-active-permission-grant-holders.integration.spec.ts and
  // grant-uniqueness.integration.spec.ts, which fail immediately if that
  // ever happens). `prisma generate` only reads this file and never
  // touches the database, so it remains safe.
  @@unique([user_id, permission_id, scope_type, event_id], map: "user_permission_grants_unique")
  @@index([user_id])
  @@index([event_id])
  @@map("user_permission_grants")
}

// ─── Payments ───────────────────────────────────────────────────────────────

model TenantPayoutMethod {
  id         String         @id @default(uuid()) @db.Uuid
  tenant_id  String         @db.Uuid
  provider   PayoutProvider
  is_active  Boolean        @default(true)
  sort_order Int            @default(0)

  mode                  PaymentMode?
  status                PaymentAccountStatus @default(pending)
  receiver_identifier   String?              @db.VarChar(100)
  credentials_encrypted String?              @db.Text
  verified_at           DateTime?            @db.Timestamptz

  bank_name             String? @db.VarChar(100)
  account_number        String? @db.VarChar(50)
  account_type          String? @db.VarChar(20)
  account_holder        String? @db.VarChar(200)
  holder_identification String? @db.VarChar(20)

  configured_by_id String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz

  tenant        Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  configured_by User?               @relation("PayoutMethodConfiguredBy", fields: [configured_by_id], references: [id], onDelete: SetNull)
  event_copies  EventPayoutMethod[]

  @@index([tenant_id, is_active])
  @@map("tenant_payout_methods")
}

model PaymentTransaction {
  id                     String          @id @default(uuid()) @db.Uuid
  client_transaction_id  String          @unique @db.VarChar(50)
  provider               PaymentProvider
  gateway_transaction_id String?         @db.VarChar(100)

  status PaymentTransactionStatus @default(initiated)

  amount_cents             Int
  amount_without_tax_cents Int
  amount_with_tax_cents    Int
  tax_cents                Int
  commission_cents         Int
  transfer_to_cents        Int?

  mode_snapshot     PaymentMode
  receiver_snapshot String      @db.VarChar(100)
  store_id_snapshot String?     @db.VarChar(100)

  authorization_code String? @db.VarChar(50)
  card_brand         String? @db.VarChar(80)
  last_digits        String? @db.VarChar(8)
  confirm_payload    Json?
  failure_message    String? @db.Text

  confirmed_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz

  orders PaymentTransactionOrder[]

  @@index([status])
  @@map("payment_transactions")
}

model PaymentTransactionOrder {
  payment_transaction_id String @db.Uuid
  order_id               String @db.Uuid

  payment_transaction PaymentTransaction @relation(fields: [payment_transaction_id], references: [id], onDelete: Restrict)
  order               Order              @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@id([payment_transaction_id, order_id])
  @@index([order_id])
  @@map("payment_transaction_orders")
}

model EventPayoutMethod {
  id         String         @id @default(uuid()) @db.Uuid
  event_id   String         @db.Uuid
  provider   PayoutProvider
  is_active  Boolean        @default(true)
  sort_order Int            @default(0)

  mode                PaymentMode?
  receiver_identifier String?      @db.VarChar(100)

  bank_name             String? @db.VarChar(100)
  account_number        String? @db.VarChar(50)
  account_type          String? @db.VarChar(20)
  account_holder        String? @db.VarChar(200)
  holder_identification String? @db.VarChar(20)

  source_payout_method_id String?  @db.Uuid
  created_at              DateTime @default(now()) @db.Timestamptz
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz

  event  Event               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  source TenantPayoutMethod? @relation(fields: [source_payout_method_id], references: [id], onDelete: SetNull)

  @@index([event_id, is_active])
  @@map("event_payout_methods")
}
